# Minimal LKL config for wasm32 (workerd). Grow features from here.
CONFIG_EXPERT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK_TIME=y
# CONFIG_KALLSYMS is not set
# Networking: Unix sockets only (local IPC: tokio, systemd, D-Bus); no IP
CONFIG_NET=y
CONFIG_UNIX=y
# CONFIG_INET is not set
# CONFIG_WIRELESS is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_PCI is not set
# CONFIG_VT is not set
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_LKL_HOSTBLK=y
CONFIG_EXT4_FS=y
CONFIG_DEBUG_INFO_NONE=y
# Nothing to drive: no keyboards, mice, sensors, firmware or hardware RNGs
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_HWMON is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_FW_LOADER is not set
# Unused kernel features
# CONFIG_FTRACE is not set
# CONFIG_IO_URING is not set
# CONFIG_AIO is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# 512 /dev/{pty,tty}XX nodes, each a devtmpfs round trip at boot; devpts
# (/dev/ptmx, UNIX98) is what programs use
# CONFIG_LEGACY_PTYS is not set
# What an init system (systemd) needs besides Unix sockets: cgroup v2; pid
# and mount namespaces (the init runs as pid 1 of its own pid namespace, as
# in a container); file handles; autofs; memfd_create (systemd hands each
# service its state in a memfd). No shmem without an MMU: tmpfs and memfds
# are ramfs (no xattrs, no seals).
CONFIG_MEMFD_CREATE=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
