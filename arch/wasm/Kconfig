config WASM
	def_bool y
	select ARCH_HAS_SYSCALL_WRAPPER
	select ARCH_HAS_MEMBLOCK_MATERIALIZE
	select ARCH_WANTS_BUDDY_ALLOCATOR_BOTTOM_UP
	select ARCH_NO_PREEMPT
	select ARCH_NO_SWAP
	select BUG
	select FLATMEM
	select GENERIC_CPU_DEVICES
	select GENERIC_CSUM
	select GENERIC_ENTRY
	select GENERIC_HWEIGHT
	select GENERIC_IRQ_MIGRATION if SMP
	select GENERIC_IRQ_PROBE
	select GENERIC_IRQ_SHOW
	select GENERIC_SMP_IDLE_THREAD
	select HOTPLUG_PARALLEL if SMP
	select IRQ_DOMAIN
	select OF
	select OF_EARLY_FLATTREE
	select OF_IRQ
	select HAVE_PAGE_SIZE_4KB
	select HAVE_PAGE_SIZE_64KB
	select SMP if !WASM_JSPI
	select THREAD_INFO_IN_TASK

config WASM_JSPI
	bool "Run every task on one JavaScript event loop (JSPI)"
	help
	  One CPU, and every task a coroutine on the host's event loop: a task
	  blocks by suspending through JavaScript Promise Integration, not by
	  waiting on an atomic in a worker of its own. The kernel enters user
	  code through its own function table (call_indirect), so no
	  JavaScript frame is between a task's syscall and its suspension.

config EXOBOX
	bool "exobox's host interface"
	depends on WASM_JSPI
	help
	  What exobox's host (packages/exobox in its fork of tombl/distro)
	  adds, in arch/wasm/exobox/: fork (clone returning twice, the
	  program unwinding its stack with Asyncify).

config CMDLINE
	string "Kernel command string to append"
	default ""

config MMU
	def_bool n

config EARLY_PRINTK
	def_bool y

config SMP
	# (one CPU on one event loop: a uniprocessor kernel)
	def_bool !WASM_JSPI

config NR_CPUS
	int
	default 1 if !SMP
	default 64 if SMP

config HZ
	int
	default 100

config GENERIC_BUG
	bool

config GENERIC_HWEIGHT
	def_bool y

config GENERIC_CSUM
	def_bool y

config ARCH_DMA_ADDR_T_64BIT
	def_bool 64BIT

config PHYS_ADDR_T_64BIT
	def_bool 64BIT

config 64BIT
	bool "64bit kernel"
	default n

config HIGHMEM
	def_bool n
	select KMAP_LOCAL

config CONSOLE_LOGLEVEL_QUIET
	int "quiet console loglevel (1-15)"
	range 1 15
	default "4"

config LD_IS_WASMLD
	def_bool y

config DEFAULT_MEM_START
	hex
	prompt "PAGE_OFFSET/PHYS_OFFSET" if !MMU
	default 0x00000000
	help
	  This is the base address used for both PAGE_OFFSET and PHYS_OFFSET
	  in noMMU configurations.

	  If unsure, leave the default value here.

source "arch/wasm/drivers/Kconfig"
